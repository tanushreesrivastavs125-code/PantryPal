# ==============================================================================
# PantryPal Backend Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pantrypal?schema=public

# Database Connection (MongoDB - NoSQL for AI Telemetry)
MONGO_URI=mongodb://localhost:27017/pantrypal_ai

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=1h

# CORS Configuration
# Comma-separated list of allowed origins for browser clients
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# API Rate Limiting
# RATE_LIMIT_WINDOW_MS: Window duration in milliseconds (default: 900000 = 15 minutes)
# RATE_LIMIT_MAX_REQUESTS: Max allowed requests per IP per window (default: 500)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Reverse Proxy / Load Balancer Configuration
# Set to 'true' if running behind Nginx, Cloudflare, AWS ALB, or Docker proxy
TRUST_PROXY=false

# AI & LLM Integration (Google GenAI)
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT=30000